# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Extra working copies Claude Code creates for background jobs
.claude/worktrees/

# Personal study notes (may contain copyrighted course material) — never commit.
# The leading "/" means only the top-level notes folder, not tests/fixtures/notes.
/notes/

# Personal flashcards and review history (the user's own data, not code)
/data/

# Downloaded embedding model and saved note vectors (rebuilt automatically)
.cache/
